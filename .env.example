# Google Gemini API Keys (Up to 4 keys for parallel execution)
# Get keys at: https://aistudio.google.com/
GEMINI_API_KEY_1=your_api_key_1_here
GEMINI_API_KEY_2=your_api_key_2_here
GEMINI_API_KEY_3=your_api_key_3_here
GEMINI_API_KEY_4=your_api_key_4_here

# Fallback default key
GEMINI_API_KEY=your_api_key_1_here

# The model to be used (default is gemma-4-31b-it)
GEMMA_MODEL=gemma-4-31b-it

# Thinking mode: HIGH, MEDIUM, LOW, MINIMAL (default: HIGH)
THINKING_LEVEL=HIGH

# Request timeout in seconds for deep thinking (default: 900)
API_TIMEOUT=900

# Max output tokens limit per request (default: 16384)
MAX_OUTPUT_TOKENS=16384